    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_tagline">A calorie and macro tracker with no ads, no tracking and no account.</string>
    <string name="about_privacy_title">Your data</string>
    <string name="about_privacy">Everything you log stays on this phone. The app only goes online when you search Open Food Facts, and then it sends only the words you searched for.</string>
